---
const base = import.meta.env.BASE_URL;
---
<a href={base} class="site-title">
  <img src={`${base}favicon.svg`} alt="" width="28" height="28" />
  <span>Foveate</span>
</a>
<style>
  .site-title { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--sl-color-white); font-weight: 650; font-size: 1.1rem; text-decoration: none; letter-spacing: -0.01em; }
  .site-title img { border-radius: 7px; }
</style>
