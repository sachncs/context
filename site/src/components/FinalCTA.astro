---
import Icons from "./Icons.astro";
const gh = "https://github.com/sachncs/context";
const pypi = "https://pypi.org/project/ceng-context/";
---
<section class="relative overflow-hidden border-t border-white/6 py-24 sm:py-32"><div class="absolute inset-0 bg-grid opacity-40"></div><div class="relative mx-auto max-w-3xl px-5 text-center sm:px-6"><p class="eyebrow">Start with one function</p><h2 class="mt-5 text-balance text-4xl font-semibold tracking-[-.04em] text-white sm:text-5xl">Your context pipeline can be simpler.</h2><p class="mx-auto mt-6 max-w-xl text-lg leading-8 text-slate-400">Install the package, keep your existing stack, and make the parts that matter explicit.</p><div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row"><a href={pypi} target="_blank" rel="noreferrer" class="btn btn-primary px-7 py-3.5 text-[.94rem]">Install ceng-context <Icons name="arrow-right" class="h-4 w-4" /></a><a href={gh} target="_blank" rel="noreferrer" class="btn btn-ghost px-7 py-3.5 text-[.94rem]"><Icons name="github" class="h-4 w-4" strokeWidth={0} /> Explore source</a></div></div></section>
