---
import Icons from "./Icons.astro";

const gh = "https://github.com/sachncs/context";
---

<section class="relative overflow-hidden py-28 sm:py-40">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="glow-a left-1/2 top-1/2 h-[560px] w-[820px] -ml-[410px] -mt-80 opacity-70"></div>
    <div class="bg-grid absolute inset-0 opacity-70"></div>
    <div
      class="absolute inset-0"
      style="background: radial-gradient(ellipse 90% 60% at 50% 50%, transparent 30%, #04050a 90%);"
    ></div>
  </div>

  <div
    class="relative mx-auto max-w-3xl px-5 text-center sm:px-6"
  >
    <div data-reveal>
      <p class="eyebrow">Enough reading</p>
      <h2
        class="mt-5 text-balance text-4xl font-semibold tracking-[-0.02em] text-white sm:text-5xl"
      >
        Stop managing context.
        <br />
        <span class="text-gradient">Start engineering it.</span>
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-slate-400">
        Whatever you build — agents, RAG, evals, long-running chats — ceng
        gives you the researched primitives to make your tokens count.
      </p>
    </div>

    <div
      class="mt-10 flex flex-col items-center justify-center gap-3.5 sm:flex-row"
      data-reveal
      style="--reveal-delay: 140ms"
    >
      <a href="#install" class="btn btn-primary px-8 py-3.5 text-[0.98rem]">
        <Icons name="terminal" class="h-4 w-4" />
        pip install ceng
      </a>
      <a
        href={gh}
        target="_blank"
        rel="noreferrer"
        class="btn btn-ghost px-8 py-3.5 text-[0.98rem]"
      >
        <Icons name="github" class="h-4 w-4" strokeWidth={0} />
        View the source
      </a>
    </div>

    <p class="mt-8 font-mono text-[0.74rem] text-slate-600" data-reveal style="--reveal-delay: 220ms">
      Apache-2.0 · no telemetry · no hidden agents
    </p>
  </div>
</section>