---
import Icons from "./Icons.astro";
const features = [
  { icon: "layers", eyebrow: "Compress", title: "Keep the signal. Lose the bulk.", body: "Partition long inputs, summarise them safely, and combine the result within a token budget.", code: "ppa_compress(messages, budget_tokens=2400)" },
  { icon: "shield", eyebrow: "Check", title: "Catch bad context early.", body: "Compare whole-population answers with leaf-level answers before a weak summary reaches your model.", code: "ppa_check(question, population, tree)" },
  { icon: "cube", eyebrow: "Store", title: "Make context portable.", body: "Write compact, inspectable bundles to disk. Bring them into any application when they are useful.", code: "ppa_compress_to_okf(messages, bundle_dir=...)" },
];
---
<section id="product" class="relative border-t border-white/6 py-24 sm:py-32"><div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8"><div class="grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-20"><div data-reveal><p class="eyebrow">A small surface area</p><h2 class="mt-5 text-balance text-4xl font-semibold tracking-[-.035em] text-white sm:text-5xl">Tools that stay out of the way.</h2><p class="mt-6 max-w-md text-lg leading-8 text-slate-400">Use one primitive or compose a complete context pipeline. ceng is deliberately boring at the boundary: Python functions, typed results, and files you can inspect.</p><a href="#install" class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-brand-200 transition-colors hover:text-white">See the install path <Icons name="arrow-right" class="h-4 w-4" /></a></div><div class="grid gap-4 sm:grid-cols-3" data-reveal style="--reveal-delay:120ms">{features.map((f, i) => <article class="card-line flex flex-col rounded-2xl p-5 sm:p-6"><div class="flex items-center justify-between"><div class="flex h-10 w-10 items-center justify-center rounded-xl border border-brand-400/20 bg-brand-500/[.1] text-brand-200"><Icons name={f.icon} class="h-4 w-4" /></div><span class="font-mono text-[.68rem] text-slate-600">0{i + 1}</span></div><p class="mt-7 text-[.7rem] font-semibold tracking-[.16em] text-brand-200 uppercase">{f.eyebrow}</p><h3 class="mt-2 text-lg font-semibold leading-snug text-white">{f.title}</h3><p class="mt-3 flex-1 text-[.88rem] leading-6 text-slate-400">{f.body}</p><p class="mt-5 border-t border-white/8 pt-4 font-mono text-[.68rem] leading-5 text-slate-500">{f.code}</p></article>)}</div></div></div></section>
