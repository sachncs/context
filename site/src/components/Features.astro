---
import Icons from "./Icons.astro";
const features = [
  { icon: "layers", eyebrow: "Foveate", title: "Full detail only where it matters.", body: "Relevant pages stay verbatim, their neighbours are condensed, and the rest becomes a one-line outline, all inside the token budget you set.", code: "Foveator(runtime, budget=6000).plan(q, [doc])" },
  { icon: "shield", eyebrow: "Ground", title: "Answers you can audit.", body: "Every citation is a document, page and quote. Quotes are checked against the source page; unsupported answers are retried, flagged, or turned into an explicit not-found.", code: "answer.grounded, answer.citations" },
  { icon: "cube", eyebrow: "Operate", title: "Built for agents and production.", body: "Page tools and history compression for Pydantic AI, Google ADK and LangGraph. Retries, circuit breaker, cache and OpenTelemetry spans around any model.", code: "foveate_pai.document_tools([doc])" },
];
---
<section id="product" class="relative border-t border-white/6 py-24 sm:py-32"><div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8"><div class="grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-20"><div data-reveal><p class="eyebrow">Three ideas</p><h2 class="mt-5 text-balance text-4xl font-semibold tracking-[-.035em] text-white sm:text-5xl">Less in the window. More you can trust.</h2><p class="mt-6 max-w-md text-lg leading-8 text-slate-400">Upload 200 pages and the model sees the few that matter, in the detail they deserve, with a receipt for every claim.</p><a href="#install" class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-brand-200 transition-colors hover:text-white">Read the quickstart <Icons name="arrow-right" class="h-4 w-4" /></a></div><div class="grid gap-4 sm:grid-cols-3" data-reveal style="--reveal-delay:120ms">{features.map((f, i) => <article class="card-line flex flex-col rounded-2xl p-5 sm:p-6"><div class="flex items-center justify-between"><div class="flex h-10 w-10 items-center justify-center rounded-xl border border-brand-400/20 bg-brand-500/[.1] text-brand-200"><Icons name={f.icon} class="h-4 w-4" /></div><span class="font-mono text-[.68rem] text-slate-600">0{i + 1}</span></div><p class="mt-7 text-[.7rem] font-semibold tracking-[.16em] text-brand-200 uppercase">{f.eyebrow}</p><h3 class="mt-2 text-lg font-semibold leading-snug text-white">{f.title}</h3><p class="mt-3 flex-1 text-[.88rem] leading-6 text-slate-400">{f.body}</p><p class="mt-5 border-t border-white/8 pt-4 font-mono text-[.68rem] leading-5 text-slate-500">{f.code}</p></article>)}</div></div></div></section>
