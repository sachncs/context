---
const base = import.meta.env.BASE_URL;
---
<footer class="site-footer">
  <div class="wrap cols">
    <div>
      <strong>Foveate</strong>
      <p class="muted">Context engineering for LLM apps. Apache-2.0. Python 3.10 to 3.13.</p>
    </div>
    <nav aria-label="Footer">
      <a href={`${base}docs/quickstart/`}>Quickstart</a>
      <a href={`${base}docs/concepts/`}>Concepts</a>
      <a href={`${base}evidence/`}>Evidence</a>
      <a href={`${base}docs/benchmarks/`}>Benchmark method</a>
      <a href={`${base}docs/playbook/`}>The twelve rules</a>
      <a href={`${base}docs/research/`}>Research</a>
      <a href={`${base}roadmap/`}>Coming next</a>
      <a href="https://github.com/sachncs/foveate">GitHub</a>
      <a href="https://github.com/sachncs/foveate/blob/master/CHANGELOG.md">Changelog</a>
    </nav>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--border); padding-block: var(--space-12); background: var(--surface-2); }
  .cols { display: flex; flex-wrap: wrap; gap: var(--space-8); justify-content: space-between; }
  p { margin-top: .4rem; max-width: 28rem; font-size: .92rem; }
  nav { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); align-content: start; }
  nav a { color: var(--muted); text-decoration: none; font-size: .95rem; }
  nav a:hover { color: var(--text); }
</style>
