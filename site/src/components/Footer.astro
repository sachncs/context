---
import Logo from "./Logo.astro";
import Icons from "./Icons.astro";
const gh = "https://github.com/sachncs/context";
const pypi = "https://pypi.org/project/ceng-context/";
---
<footer class="relative border-t border-white/6 bg-ink-925/40"><div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 lg:px-8"><div class="flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between"><div><Logo size={29} withWordmark /><p class="mt-4 max-w-sm text-[.9rem] leading-6 text-slate-500">A focused Python toolkit for making long context useful.</p></div><div class="flex flex-wrap items-center gap-3"><a href={pypi} target="_blank" rel="noreferrer" class="footer-link">PyPI <Icons name="arrow-right" class="h-3.5 w-3.5" /></a><a href={gh} target="_blank" rel="noreferrer" class="footer-link"><Icons name="github" class="h-3.5 w-3.5" strokeWidth={0} /> GitHub</a></div></div><div class="mt-10 flex flex-col justify-between gap-3 border-t border-white/6 pt-6 text-[.75rem] text-slate-600 sm:flex-row"><span>© 2026 ceng contributors · Apache-2.0</span><span>v1.0.0 · Python 3.10–3.13</span></div></div></footer>
<style>
  .footer-link { display: inline-flex; align-items: center; gap: .4rem; border: 1px solid rgb(255 255 255 / .1); border-radius: 999px; padding: .65rem .85rem; color: rgb(148 163 184); font-size: .8rem; transition: all .2s ease; }
  .footer-link:hover { border-color: rgb(255 255 255 / .25); color: white; }
</style>
