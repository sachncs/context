---
import Logo from "./Logo.astro";
import Icons from "./Icons.astro";

const gh = "https://github.com/sachncs/context";

const cols = [
  {
    title: "Product",
    links: [
      { label: "Overview", href: "#product" },
      { label: "Features", href: "#features" },
      { label: "Research roots", href: "#research" },
      { label: "Install", href: "#install" },
    ],
  },
  {
    title: "Documentation",
    links: [
      { label: "README", href: `${gh}/blob/master/README.md` },
      { label: "Architecture", href: `${gh}/blob/master/ARCHITECTURE.md` },
      { label: "Benchmarks", href: `${gh}/blob/master/BENCHMARKS.md` },
      { label: "Changelog", href: `${gh}/blob/master/CHANGELOG.md` },
      { label: "Examples", href: `${gh}/tree/master/examples` },
    ],
  },
  {
    title: "Community",
    links: [
      { label: "Contributing", href: `${gh}/blob/master/CONTRIBUTING.md` },
      { label: "Code of conduct", href: `${gh}/blob/master/CODE_OF_CONDUCT.md` },
      { label: "Security", href: `${gh}/blob/master/SECURITY.md` },
      { label: "Issues", href: `${gh}/issues` },
    ],
  },
];
---

<footer class="relative border-t border-white/6 bg-ink-925/40">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[1.3fr_2fr]">
      <div>
        <Logo size={30} withWordmark />
        <p class="mt-4 max-w-xs text-[0.92rem] leading-relaxed text-slate-500">
          Context, engineered. Research-grade primitives for the token-limited
          world.
        </p>
        <div class="mt-5 flex items-center gap-3">
          <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1.5 font-mono text-[0.72rem] text-slate-300">
            v1.0.0
          </span>
          <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1.5 font-mono text-[0.72rem] text-slate-300">
            Python 3.10–3.13
          </span>
          <a
            href={gh}
            target="_blank"
            rel="noreferrer"
            aria-label="ceng on GitHub"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-white/[0.04] text-slate-400 transition-all duration-300 hover:border-white/25 hover:text-white"
          >
            <Icons name="github" class="h-4 w-4" strokeWidth={0} />
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        {
          cols.map((col) => (
            <div>
              <p class="text-[0.72rem] font-bold tracking-[0.18em] text-slate-500 uppercase">
                {col.title}
              </p>
              <ul class="mt-4 flex flex-col gap-2.5">
                {
                  col.links.map((l) => (
                    <li>
                      <a
                        href={l.href}
                        target={l.href.startsWith("http") ? "_blank" : undefined}
                        rel={l.href.startsWith("http") ? "noreferrer" : undefined}
                        class="text-[0.88rem] text-slate-400 transition-colors duration-300 hover:text-white"
                      >
                        {l.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-14 border-t border-white/6 pt-7">
      <div class="flex flex-col items-center justify-between gap-3 sm:flex-row">
        <p class="text-[0.8rem] text-slate-600">
          © 2026 ceng contributors · Apache-2.0 License
        </p>
        <p class="text-[0.8rem] text-slate-600">
          Made with restraint for the context-engineering community.
        </p>
      </div>
    </div>
  </div>
</footer>
