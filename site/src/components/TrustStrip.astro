---
const refs = [
  { id: "arXiv:2607.15277", label: "Partition, Prompt, Aggregate" },
  { id: "arXiv:2510.04618", label: "Agentic Context Engineering" },
  { id: "arXiv:2510.26493", label: "Context Engineering 2.0" },
  { id: "Google Cloud 2026", label: "Open Knowledge Format" },
  { id: "Anthropic 2025", label: "Effective Context Engineering" },
];
---

<section class="relative border-y border-white/6 bg-ink-925/50 py-8">
  <div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8">
    <p
      class="text-center text-[0.7rem] font-semibold tracking-[0.24em] text-slate-500 uppercase"
    >
      Built on the research you can cite
    </p>
    <div
      class="mt-5 flex flex-wrap items-center justify-center gap-x-8 gap-y-3"
    >
      {
        refs.map((r) => (
          <span
            class="flex items-center gap-2 text-[0.82rem] text-slate-400"
          >
            <span
              class="font-mono text-[0.72rem] text-brand-300/90 ring-1 ring-brand-400/20 rounded-md px-1.5 py-0.5 bg-brand-500/[0.06]"
            >
              {r.id}
            </span>
            {r.label}
          </span>
        ))
      }
    </div>
  </div>
</section>