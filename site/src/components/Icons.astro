  layersgrad: `<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>`,
  pin: `<path d="M12 17v5"/><path d="M9 2h6l-1 7h3l-5 6-5-6h3z"/>`,
};

const githubFill = name === "github" ? "currentColor" : fill;
const githubStroke = name === "github" ? "none" : stroke;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill={githubFill}
  stroke={githubStroke}
  stroke-width={name === "github" ? 0 : strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={["shrink-0", cls]}
  aria-hidden="true"
>
  {
    name === "github"
      ? <path d={paths[name] || ""} />
      : <Fragment set:html={paths[name] || ""} />
  }
</svg>