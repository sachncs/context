---
import fs from 'node:fs';
import path from 'node:path';

const base = import.meta.env.BASE_URL;
let summary: any = null;
let allRuns: any[] = [];
const dir = path.resolve(process.cwd(), 'src', 'data', 'results');
if (fs.existsSync(dir)) {
  const runs = fs
    .readdirSync(dir)
    .map((name) => path.join(dir, name, 'summary.json'))
    .filter((file) => fs.existsSync(file))
    .map((file) => JSON.parse(fs.readFileSync(file, 'utf-8')))
    .filter((run) => Array.isArray(run.rows))
    .sort((a, b) => String(b.timestamp).localeCompare(String(a.timestamp)));
  summary = runs[0] ?? null;
  allRuns = runs;
}
const pct = (x: number) => `${Math.round(x * 100)}%`;
const tokens = (x: number) => (x ? Math.round(x).toLocaleString('en-US') : 'n/a');
const names: Record<string, string> = {
  'full-context': 'Send everything',
  truncate: 'Truncate',
  'naive-rag': 'Plain RAG',
  foveate: 'Foveate',
};
---
{allRuns.length > 0 ? (
  <div class="runs">
    {[...allRuns].reverse().map((run: any) => (
      <div>
        <h3>{run.rows.some((r: any) => r.pipeline === 'full-context') ? 'Run 1: default settings (keyword retrieval)' : 'Run 2: embeddings and query expansion'}</h3>
        <div class="scroll">
          <table>
            <caption>
              FinanceBench, {run.documents} filings, answer model {run.model}, evidence budget {run.budget.toLocaleString('en-US')} tokens. Run on {String(run.timestamp).slice(0, 10)}.
            </caption>
            <thead>
              <tr><th scope="col">Pipeline</th><th scope="col">Correct</th><th scope="col">Quotes verified</th><th scope="col">Abstains when it should</th><th scope="col">Prompt tokens</th></tr>
            </thead>
            <tbody>
              {run.rows.map((r: any) => (
                <tr class={r.pipeline === 'foveate' ? 'hl' : ''}>
                  <th scope="row">{names[r.pipeline] ?? r.pipeline}</th>
                  <td>{pct(r.accuracy)}</td>
                  <td>{pct(r.grounded)}</td>
                  <td>{r.unanswerable ? pct(r.correct_abstain) : 'n/a'}</td>
                  <td>{tokens(r.prompt_tokens)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ))}
    <p class="muted note">All numbers come from <a href={`${base}docs/benchmarks/`}>the benchmark runs</a>, including the ones where Foveate does not win. Thirty questions is a small sample.</p>
  </div>
) : (
  <div class="card pending">
    <h3>No benchmark results found</h3>
    <p class="muted">Run the benchmark to fill this table. <a href={`${base}docs/benchmarks/`}>Read the method</a></p>
  </div>
)}
<style>
  .scroll { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  table { border-collapse: collapse; width: 100%; min-width: 36rem; font-size: .95rem; }
  caption { text-align: left; padding: var(--space-4); color: var(--muted); font-size: .85rem; }
  th, td { text-align: left; padding: .75rem var(--space-4); border-top: 1px solid var(--border); font-variant-numeric: tabular-nums; }
  thead th { font-size: .78rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  tr.hl { background: var(--accent-soft); }
  .note { margin-top: var(--space-4); font-size: .9rem; }
  .runs { display: grid; gap: var(--space-8); }
  .runs h3 { margin-bottom: var(--space-3); }
  .pending p + p { margin-top: var(--space-3); }
</style>
